# --- Server ---
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed origins for the SPA (required in production).
# Example: https://chat.example.com,https://www.chat.example.com
CLIENT_ORIGIN=https://chat.example.com

# Force secure cookies regardless of NODE_ENV ("1" to enable). Recommended behind HTTPS proxy.
SESSION_COOKIE_SECURE=1

# Where the SQLite DB lives. In Docker this is volume-mounted.
DATA_DIR=/app/data

# Trinity upstream — fill with real values
TRINITY_OPENAI_URL=https://your-gate/openai/v1
TRINITY_OPENAI_KEY=sk-...
TRINITY_ANTHROPIC_URL=https://your-gate/anthropic
TRINITY_ANTHROPIC_KEY=sk-ant-...
