# ── MiniChat server configuration ────────────────────────────────────────────
# Copy to server/.env and fill in. Never commit the real .env.

# ── Trinity proxy (REQUIRED) ─────────────────────────────────────────────────
# OpenAI-compatible endpoint + key (GPT models).
TRINITY_OPENAI_URL=https://gate.trinity.tg/orion/v1
TRINITY_OPENAI_KEY=

# Anthropic-compatible endpoint + key (Claude models + agent proxy upstream).
TRINITY_ANTHROPIC_URL=https://gate.trinity.tg/aurora/v1
TRINITY_ANTHROPIC_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# HTTP port the server listens on.
PORT=3001

# 'production' enables SPA serving, secure cookies and trust-proxy.
NODE_ENV=development

# Comma-separated allowed CORS origins. REQUIRED in production.
CLIENT_ORIGIN=http://localhost:5173

# Force the 'Secure' flag on the session cookie. Defaults to on in production.
# SESSION_COOKIE_SECURE=1

# SQLite data directory (the DB file lives here).
# DATA_DIR=./data

# ── Claude Code Web: workspaces & agent (REQUIRED for agent/GitHub features) ──
# AES-256-GCM key for encrypting secrets at rest (GitHub PATs). 64 hex chars
# (= 32 bytes). Generate with:  openssl rand -hex 32
# GitHub features degrade gracefully if this is unset.
SECRETS_KEY=

# Docker image tag used for per-user workspace containers.
# Build it with:  npm run build:workspace-image -w server
WORKSPACE_IMAGE=minichat-workspace:latest

# Idle minutes before the reaper stops a running workspace container.
WORKSPACE_IDLE_MINUTES=15

# How a workspace container reaches the agent billing proxy on the host.
# Defaults to http://host.docker.internal:<PORT>/api/agent-proxy.
# Override on Linux if host.docker.internal isn't mapped (e.g. the bridge IP):
# AGENT_PROXY_BASE_URL=http://172.17.0.1:3001/api/agent-proxy
